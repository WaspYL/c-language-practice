{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: cl.exe 生成活动文件",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "\"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cl /Zi /Od /EHsc /W4 /Fe:\"${fileDirname}\\${fileBasenameNoExtension}.exe\" /Fo:\"${fileDirname}\\\" \"${file}\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "detail": "使用VS2026的cl.exe编译器编译当前文件"
        }
    ]
}
